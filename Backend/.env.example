# Database Configuration
DATABASE_URL=mongodb://localhost:27017/nestjs_boilerplate

# Application Configuration
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=7d
JWT_ACCESS_SECRET_KEY=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET_KEY=your-super-secret-refresh-key-change-this-in-production

# Sentry Configuration (error tracking in production)
SENTRY_DSN=

# Twilio (SMS/OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Content Moderation
MODERATE_CONTENT_API_KEY=

# Cloudinary (image/file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# DigiLocker (identity verification)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# Google GenAI Configuration
GOOGLE_GENAI_API_KEY=your-google-genai-api-key
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# CLOUDFLARE
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=my-app-images
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-abc123.r2.dev
